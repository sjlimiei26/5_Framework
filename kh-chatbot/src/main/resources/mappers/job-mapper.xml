<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.ems.job.model.mapper.JobMapper">
    <select id="selectAll" resultType="com.kh.ems.job.model.vo.Job">
        SELECT 
            JOB_CODE as jobCode,
            JOB_NAME as jobName
        FROM JOB
    </select>
    <select id="selectCount" resultType="_int">
        SELECT COUNT(*) FROM JOB
    </select>
</mapper>
